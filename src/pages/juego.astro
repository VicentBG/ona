---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo="Juega con Ona" descripcion="Un paseo de plataformas con Ona: salta, encuentra conejos y vuelve a casa.">
  <section class="juego">
    <div class="game-intro">
      <p class="etiqueta">Un paseo con Ona · dibujos originales</p>
      <h1>Juega con Ona</h1>
      <p>Salta entre las plataformas, encuentra los tres conejos y esquiva al jabalí del camino. La casita es la meta: puedes volver sin encontrarlos todos. Tienes tres vidas; después de un contacto, Ona queda protegida un instante.</p>
    </div>
    <div class="game-shell" data-game>
      <div class="game-stage" id="partida-ona" data-stage>
      <div class="game-hud">
        <p>Vidas: <span data-lives>3</span> · Conejos: <span data-count>0</span>/3</p>
        <div class="game-actions">
          <button type="button" data-start>Jugar</button>
          <button type="button" data-pause disabled>Pausa</button>
          <button type="button" data-resume hidden>Continuar</button>
          <button type="button" data-restart disabled>Reiniciar</button>
          <button type="button" data-fullscreen aria-controls="partida-ona" hidden>Pantalla completa</button>
        </div>
      </div>
      <p class="game-status" data-status role="status">Para jugar necesitas activar JavaScript. El resto de la web no lo necesita.</p>
      <div class="game-view">
        <div class="game-field" data-field tabindex="0" role="group" aria-label="Campo de juego de Ona" aria-describedby="instrucciones-juego"></div>
      </div>
      <div class="game-controls" aria-label="Controles de juego">
        <div class="game-directions">
          <button type="button" data-action="izquierda" aria-label="Mover a la izquierda" disabled>←</button>
          <button type="button" data-action="derecha" aria-label="Mover a la derecha" disabled>→</button>
        </div>
        <button type="button" data-action="salto" disabled>Saltar</button>
      </div>
      </div>
      <p id="instrucciones-juego"><strong>Teclado:</strong> enfoca el campo de juego y usa ←/→ o A/D para moverte y Espacio, ↑ o W para saltar. Escape pausa. Tab permite salir sin atrapar el foco.<br /><strong>Táctil:</strong> mantén una dirección con un dedo y pulsa Saltar con otro. Mantener Saltar no repite el salto. Horizontal recomendado, no obligatorio. Al interrumpir la partida tendrás que pulsar Continuar. Si el navegador lo permite, usa Pantalla completa y Salir; no se cambia la orientación automáticamente.</p>
      <p class="game-note">El escenario es visual: los botones y estados están en HTML, pero esto no ofrece una experiencia de juego íntegramente accesible. El juego no tiene sonido ni guarda partidas.</p>
      <noscript><p>JavaScript está desactivado. Puedes seguir leyendo la historia y el diario de Ona mediante la navegación de la web.</p></noscript>
    </div>
  </section>
</BaseLayout>

<script>
  import { montarJuego } from '../game/controller.js';
  const root = document.querySelector('[data-game]');
  if (root) {
    let desmontar = montarJuego(root);
    window.addEventListener('pagehide', () => desmontar());
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) desmontar = montarJuego(root);
    });
  }
</script>

<style>
  .juego { max-inline-size: 65rem; margin-inline: auto; padding: 2rem 1rem 3rem; }
  .game-intro { max-inline-size: 48rem; margin-block-end: 1.5rem; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); margin-block: 0.25rem 1rem; }
  .etiqueta, .game-note { font-size: 0.9rem; }
  .etiqueta { font-weight: 800; }
  .game-shell { container: game / inline-size; min-inline-size: 0; padding-inline: max(0px, env(safe-area-inset-left)) max(0px, env(safe-area-inset-right)); padding-block-end: env(safe-area-inset-bottom); }
  .game-hud, .game-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .game-hud { justify-content: space-between; }
  .game-stage { scroll-margin-block-start: 0.25rem; }
  .game-hud p { margin-block: 0.5rem; font-weight: 800; font-size: 0.9rem; }
  .game-status { min-block-size: 3.4em; margin-block: 0.3rem; font-size: 0.9rem; line-height: 1.5; }
  .game-field { position: relative; inline-size: min(100%, 50rem); aspect-ratio: 16 / 9; margin-inline: auto; background: #e9f4f5; box-shadow: 0 0 0 3px var(--tinta); border-radius: 0.5rem; scroll-margin-block-start: 0.5rem; overflow: hidden; }
  .game-field :global(canvas) { display: block; }
  button { font: inherit; font-weight: 800; min-inline-size: 3rem; min-block-size: 3rem; padding: 0.65rem 1rem; color: var(--tinta); background: var(--amarillo); border: 2px solid var(--tinta); border-radius: 0.75rem; cursor: pointer; }
  button:disabled { opacity: 0.5; cursor: default; }
  button:focus-visible, .game-field:focus-visible { outline: 3px solid #246451; outline-offset: 3px; }
  button[hidden] { display: none; }
  .game-controls { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-block: 0.75rem; }
  .game-directions { display: flex; flex-wrap: wrap; max-inline-size: 100%; gap: 0.75rem; }
  /* Mando de pulsación continua, no superficie de navegación. El resto de la
     página (incluido el canvas) conserva scroll y zoom nativos. */
  [data-action] { min-inline-size: 4rem; min-block-size: 3.5rem; touch-action: none; user-select: none; -webkit-user-select: none; }
  .held { background: #e6f1c9; }
  .game-controls > button { min-inline-size: 6rem; }
  @container game (inline-size < 26rem) {
    .game-actions { gap: 0.5rem; }
    .game-actions button { padding-inline: 0.7rem; }
  }
  @container game (inline-size >= 30rem) {
    .game-status { min-block-size: 1.5em; }
  }
  /* En horizontal los mandos pasan a los laterales: no quitar otra franja
     vertical al campo ni usar un presupuesto fijo de altura para el canvas. */
  @media (orientation: landscape) and (max-height: 36rem) {
    .game-stage { display: grid; grid-template-areas: 'hud hud hud' 'status status status' 'left view jump'; grid-template-columns: 6rem minmax(0, 1fr) 6rem; grid-template-rows: auto auto minmax(6rem, 1fr); gap: 0.25rem 0.5rem; block-size: calc(100svh - 2.5rem); }
    .game-hud { grid-area: hud; }
    .game-status { grid-area: status; min-block-size: 0; }
    .game-view { grid-area: view; container: campo / size; min-inline-size: 0; display: grid; place-items: center; }
    .game-field { inline-size: min(100cqi, calc(100cqb * 16 / 9)); }
    .game-controls { display: contents; }
    .game-directions { grid-area: left; flex-direction: column; align-self: end; align-items: start; margin-block-end: 0.25rem; }
    [data-action='salto'] { grid-area: jump; align-self: end; justify-self: end; margin-block-end: 0.25rem; }
  }
  .game-stage:fullscreen { display: grid; grid-template-areas: 'hud hud' 'status status' 'view view' 'left jump'; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto minmax(6rem, 1fr) auto; gap: 0.5rem; inline-size: 100%; block-size: 100%; margin: 0; padding: max(0.5rem, env(safe-area-inset-top)) max(0.5rem, env(safe-area-inset-right)) max(0.5rem, env(safe-area-inset-bottom)) max(0.5rem, env(safe-area-inset-left)); background: var(--papel); overflow: auto; }
  .game-stage::backdrop { background: var(--papel); }
  .game-stage:fullscreen .game-hud { grid-area: hud; }
  .game-stage:fullscreen .game-status { grid-area: status; min-block-size: 0; }
  .game-stage:fullscreen .game-view { grid-area: view; container: campo / size; min-inline-size: 0; display: grid; place-items: center; }
  .game-stage:fullscreen .game-field { inline-size: min(100cqi, calc(100cqb * 16 / 9)); }
  .game-stage:fullscreen .game-controls { display: contents; }
  .game-stage:fullscreen .game-directions { grid-area: left; align-self: end; }
  .game-stage:fullscreen [data-action='salto'] { grid-area: jump; align-self: end; justify-self: end; }
  /* En juego el HUD ya muestra vidas/capturas. Conservar anuncios accesibles
     sin gastar una fila para repetirlos; pausa/error/final sí quedan visibles. */
  .game-stage:fullscreen[data-state='jugando'] .game-status { position: absolute; inline-size: 1px; block-size: 1px; min-block-size: 0; margin: 0; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (orientation: landscape) {
    .game-stage:fullscreen { grid-template-areas: 'hud hud hud' 'status status status' 'left view jump'; grid-template-columns: 6rem minmax(0, 1fr) 6rem; grid-template-rows: auto auto minmax(6rem, 1fr); }
    .game-stage:fullscreen .game-directions { flex-direction: column; align-items: start; }
  }
</style>
