---
import BaseLayout from '../layouts/BaseLayout.astro';

// Este JavaScript prepara los datos al generar el HTML.
const nombre = 'Ona';
const descripcion = 'Una pointerdor de 9 meses';
const fechaReferencia = 'noviembre de 2026';
const saludo = `Hola, soy ${nombre}.`;
let orden = 0;
const palabras = saludo.split(' ').map((palabra) =>
  Array.from(palabra, (letra) => ({ letra, orden: orden++ }))
);
---

<BaseLayout
  titulo="Ona · Mi primera web con Astro"
  descripcion="La primera página de Ona, una pointerdor, y el comienzo de un proyecto para aprender Astro."
>
      <section class="portada" aria-labelledby="titulo">
        <div class="hero contenedor">
          <div class="bienvenida">
            <p class="etiqueta"><span aria-hidden="true">✦</span> Una web pequeña. Una gran historia.</p>
            <h1 id="titulo" aria-label={saludo}>{palabras.map((palabra) => <><span class="palabra" aria-hidden="true">{palabra.map(({ letra, orden }) => <span class="letra" style={`--orden: ${orden}`}>{letra}</span>)}</span>{' '}</>)}</h1>
            <p class="presentacion">{descripcion} y un mundo por descubrir.</p>
            <p>Este es el comienzo de mi rincón en la web. ¿Me acompañas?</p>
            <a class="boton" href="#sobre-ona">Conóceme un poquito <span aria-hidden="true">→</span></a>
            <p class="referencia">Edad de referencia: {fechaReferencia}.</p>
          </div>

          <figure class="retrato">
            <div class="pegatina" aria-hidden="true">¡Hola, mundo! <span>🐾</span></div>
            <img class="foto-ona" src="/images/ona-portada.webp" width="720" height="959" alt="Ona, una perra blanca y negra, mirando a cámara." fetchpriority="high" decoding="async" />
            <figcaption>Ahora sí: la protagonista de esta web.</figcaption>
          </figure>
        </div>
        <svg class="onda" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 30Q180 70 360 28T720 32t360-4 360 6V70H0Z" fill="white" /></svg>
      </section>

      <nav class="explorar contenedor revelar" data-reveal="izquierda" aria-label="Explorar la página">
        <a href="#sobre-ona"><span class="icono icono-amarillo" aria-hidden="true">🐾</span><span>Conocer a Ona<small>Empezamos por lo importante</small></span><span aria-hidden="true">↗</span></a>
        <a href="#sobre-ona"><span class="icono icono-rosa" aria-hidden="true">♡</span><span>Un rincón suyo<small>Una historia por contar</small></span><span aria-hidden="true">↗</span></a>
        <a href="#proyecto"><span class="icono icono-lila" aria-hidden="true">✦</span><span>Aprender creando<small>Paso a paso, con Astro</small></span><span aria-hidden="true">↗</span></a>
      </nav>

      <section id="sobre-ona" class="panel contenedor revelar" data-reveal="izquierda" aria-labelledby="titulo-ona">
        <div class="tarjeta-huella" aria-hidden="true"><span>🐾</span><p>Pequeña web.<br />Mucho por contar.</p></div>
        <div>
          <p class="etiqueta">Un espacio para Ona</p>
          <h2 id="titulo-ona">Las grandes historias empiezan con un hola.</h2>
          <p>Me llamo {nombre} y soy una pointerdor. Este espacio está empezando: pronto podrá recoger mi historia y un pequeño diario.</p>
          <p class="nota">Ya tenemos la primera foto de Ona. Su historia y los relatos llegarán con contenido real, paso a paso.</p>
          <a class="enlace" href="#proyecto">Así estamos creando esta web <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section id="proyecto" class="proyecto contenedor revelar" data-reveal="derecha" aria-labelledby="titulo-proyecto">
        <div>
          <p class="etiqueta">Hecho con Astro</p>
          <h2 id="titulo-proyecto">Un poquito de código.<br />Un montón de ilusión.</h2>
          <p>Esta es la primera página del proyecto. HTML, CSS y un pequeño módulo JavaScript para descubrir las secciones al hacer scroll.</p>
          <p>El resto llegará después: una estructura compartida, su historia y las entradas del diario.</p>
          <a class="boton" href="#contenido">Volver a saludar <span aria-hidden="true">↑</span></a>
        </div>
        <div class="pasos">
          <div><span>01</span><p><strong>Una primera página</strong><br />El punto de partida ya está aquí.</p></div>
          <div><span>02</span><p><strong>Su historia y su diario</strong><br />Los siguientes capítulos, todavía por crear.</p></div>
          <div><span>03</span><p><strong>La primera foto de Ona</strong><br />Ya da la bienvenida en la portada.</p></div>
        </div>
      </section>
    <script>
      import { initReveal } from '../scripts/reveal.js';
      initReveal();
    </script>
</BaseLayout>

<style>
  .portada { position: relative; background: var(--menta); }
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2rem; align-items: center; padding-block: 3.5rem 4.5rem; }
  .bienvenida { max-width: 35rem; }
  .etiqueta { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { font-weight: 900; line-height: 1.12; text-wrap: balance; }
  h1 { font-size: clamp(3.1rem, 6.5vw, 5.75rem); margin-block: 1rem 1.25rem; letter-spacing: -0.055em; }
  .palabra { display: inline-block; white-space: nowrap; }
  .letra { display: inline-block; animation: llegar-letra 700ms cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(var(--orden) * 65ms); }
  h2 { font-size: clamp(2rem, 4vw, 3.2rem); margin-block: 0.75rem 1.25rem; letter-spacing: -0.04em; }
  .presentacion { font-size: clamp(1.15rem, 2.5vw, 1.4rem); font-weight: 700; }
  .referencia, .nota, figcaption { font-size: 0.85rem; }
  .boton { display: inline-flex; align-items: center; gap: 1.3rem; max-width: 100%; margin-top: 0.65rem; padding: 0.8rem 1.4rem; border-radius: 2rem; background: var(--amarillo); font-weight: 800; text-decoration: none; transition: transform 180ms ease, box-shadow 180ms ease; }
  .boton:hover { transform: translateY(-3px); box-shadow: 0 8px 18px #123a4318; }
  .retrato { position: relative; margin: 0; min-width: 0; text-align: center; }
  .foto-ona { display: block; width: min(100%, 26rem); height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 40%; margin: 0 auto 1rem; border: 10px solid var(--amarillo); border-radius: 46% 50% 44% 48%; box-shadow: 0 18px 35px #123a4318; animation: saludar 1.1s ease both; }
  .pegatina { position: absolute; right: 0; top: 0.5rem; z-index: 1; padding: 0.7rem 1.2rem; border-radius: 1.25rem; background: var(--papel); box-shadow: 0 8px 25px #123a4312; font-weight: 800; transform: rotate(6deg); animation: aparecer 700ms ease both; }
  .pegatina span { margin-left: 0.4rem; }
  .onda { position: absolute; bottom: -1px; width: 100%; height: 3rem; display: block; }
  .explorar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; padding-block: 2rem 4rem; }
  .explorar a { display: flex; align-items: center; gap: 0.8rem; padding: 1.25rem; text-decoration: none; border: 1px solid #123a431a; border-radius: 1.25rem; box-shadow: 0 5px 20px #123a4306; font-weight: 800; }
  .explorar a > span:last-child { margin-left: auto; }
  .explorar small { display: block; margin-top: 0.15rem; font-size: 0.75rem; font-weight: 400; }
  .icono { display: grid; place-items: center; width: 3rem; height: 3rem; flex-shrink: 0; border-radius: 1rem; font-size: 1.5rem; }
  .icono-amarillo { background: var(--amarillo); }
  .icono-rosa { background: var(--rosa); }
  .icono-lila { background: var(--lila); }
  .panel { display: grid; grid-template-columns: 0.8fr 1.2fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); padding-block: 1rem 5rem; }
  .tarjeta-huella { display: grid; place-content: center; min-height: 22rem; background: var(--rosa); border-radius: 38% 50% 42% 46%; text-align: center; transform: rotate(-4deg); }
  .tarjeta-huella > span { font-size: 5rem; line-height: 1.2; }
  .tarjeta-huella p { font-size: 1.8rem; line-height: 1.25; font-weight: 900; }
  .nota { padding-left: 1rem; border-left: 3px solid var(--amarillo); }
  .enlace { display: inline-block; margin-top: 0.5rem; font-weight: 800; }
  .proyecto { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; padding: clamp(1.5rem, 4vw, 3rem); background: var(--lila); border-radius: 2rem; margin-bottom: 3rem; }
  .hero > *, .panel > *, .proyecto > * { min-width: 0; }
  .pasos { display: grid; gap: 1rem; }
  .pasos > div { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.25rem; border-radius: 1rem; background: var(--papel); }
  .pasos > div > span { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--amarillo); font-weight: 900; }
  .pasos p { margin: 0; font-size: 0.9rem; }
  .revelar { --entrada-x: clamp(-8rem, -10vw, -2rem); opacity: 1; transform: none; transition: opacity 950ms ease, transform 950ms cubic-bezier(.22, 1, .36, 1); }
  .revelar[data-reveal="derecha"] { --entrada-x: clamp(2rem, 10vw, 8rem); }
  .revelar.pendiente { opacity: 0; transform: translate3d(var(--entrada-x), 24px, 0) scale(.96); }
  @keyframes llegar-letra { 0% { opacity: 0; transform: translateY(.8em) rotate(-12deg) scale(.75); } 70% { opacity: 1; transform: translateY(-.1em) rotate(3deg) scale(1.04); } 100% { opacity: 1; transform: none; } }
  @keyframes aparecer { from { opacity: 0; transform: translateY(12px) rotate(0); } to { opacity: 1; transform: translateY(0) rotate(6deg); } }
  @keyframes saludar { 0% { transform: translateY(10px) rotate(-3deg); } 60% { transform: translateY(-4px) rotate(2deg); } 100% { transform: none; } }
  @media (max-width: 55rem) {
    .hero { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .explorar { grid-template-columns: 1fr; padding-bottom: 2.5rem; gap: 0.75rem; }
    .explorar a { padding: 0.85rem 1rem; }
    .panel { gap: 2rem; }
  }
  @media (max-width: 40rem) {
    .hero { grid-template-columns: 1fr; padding-top: 2rem; gap: 1.5rem; }
    .retrato { max-width: 25rem; width: 100%; margin-inline: auto; }
    .pegatina { right: 0.25rem; }
    .panel, .proyecto { grid-template-columns: 1fr; }
    .panel { padding-top: 1rem; padding-bottom: 3rem; }
    .tarjeta-huella { min-height: 15rem; }
    .tarjeta-huella > span { font-size: 3.5rem; }
    .tarjeta-huella p { font-size: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pegatina, .foto-ona, .letra { animation: none; }
    .boton, .revelar { transition: none; }
    .boton:hover { transform: none; }
    .revelar.pendiente { opacity: 1; transform: none; }
  }
</style>
