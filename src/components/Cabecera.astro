---
import { conBase, sinBase } from '../utils/urls.js';

// Comparar rutas locales, aunque Astro entregue /ona/ en la URL del build.
const paginaActual = sinBase(Astro.url.pathname);
---

<header class="cabecera contenedor">
  <a class="marca" href={conBase('/')} aria-label="Ona, inicio"><span aria-hidden="true">🐾</span> ona<span class="punto">.</span></a>
  <nav aria-label="Principal">
    <ul>
      <li><a href={conBase('/')} aria-current={paginaActual === '/' ? 'page' : undefined}>Inicio</a></li>
      <li><a href={conBase('/su-historia/')} aria-current={paginaActual === '/su-historia' ? 'page' : undefined}>Su historia</a></li>
      <li><a href={conBase('/diario/')} aria-current={paginaActual === '/diario' ? 'page' : paginaActual.startsWith('/diario/') ? 'location' : undefined}>Diario</a></li>
      <li><a href={conBase('/#sobre-ona')}>Sobre Ona</a></li>
      <li><a href={conBase('/#proyecto')}>La web</a></li>
      <li class="saludo"><a class="nav-saludo" href={conBase('/#sobre-ona')}>¡Vamos a conocernos! <span aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</header>

<style>
  .cabecera { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.25rem; }
  .cabecera nav { min-inline-size: 0; }
  .cabecera nav ul { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin: 0; padding: 0; list-style: none; font-size: 0.95rem; font-weight: 700; }
  .cabecera nav a { display: inline-flex; align-items: center; min-block-size: 2rem; text-decoration: none; }
  .cabecera nav a:hover, .cabecera nav a[aria-current] { text-decoration: underline; }
  .cabecera nav a[aria-current] { text-decoration-thickness: 0.15em; }
  .nav-saludo { background: var(--amarillo); padding: 0.65rem 1.15rem; border-radius: 2rem; }
  @media (max-width: 40rem) {
    .cabecera { gap: 1.25rem; }
    .cabecera nav ul { gap: 1rem; font-size: 0.85rem; }
    .saludo { display: none; }
  }
</style>
